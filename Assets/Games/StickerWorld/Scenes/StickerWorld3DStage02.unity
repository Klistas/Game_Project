  goalText: "VIP \uAE08\uACE0 \uC548\uCABD\uC5D0 \uB4E4\uC5B4\uAC00\uAE30"
  introLog: "2\uBC88 \uBC29: CCTV \uC815\uBA74 \uB3CC\uD30C\uBCF4\uB2E4 VIP \uC18C\uD488\uC744
