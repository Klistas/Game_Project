  cctvZoneZ: {x: 0.15, y: 4.4}
  stageTitle: "\uC2A4\uD14C\uC774\uC9C0 03: \uAE30\uB85D \uBCF4\uAD00\uC2E4 \uD6C4\uBB38"
  goalText: "\uC624\uB978\uCABD \uD6C4\uBB38 \uBCBD\uC744 \uB6AB\uACE0 \uAE30\uB85D
    \uAE08\uACE0 \uC548\uCABD\uC5D0 \uB4E4\uC5B4\uAC00\uAE30"
  introLog: "3\uBC88 \uBC29: CCTV\uB97C \uAC1C\uCC98\uB7FC \uC9D6\uAC8C \uB9CC\uB4E4\uC5B4
    \uACBD\uBE44\uB97C \uBE7C\uB0B4\uACE0, \uADE0\uC5F4 \uBCBD\uC744 \uD130\uB728\uB9B0
    \uB4A4 \uBAB8\uC744 \uC904\uC5EC \uD6C4\uBB38\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC138\uC694."
  blockedGoalLog: "\uD6C4\uBB38 \uC55E\uAE4C\uC9C0 \uC654\uC9C0\uB9CC \uC544\uC9C1
    \uC218\uBC95\uC774 \uB35C \uC6B0\uC2A4\uAF5D\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4. \uBAB8,
    \uACBD\uBE44, \uC9C4\uC785\uB85C\uB97C \uBAA8\uB450 \uBE44\uD2C0\uC5B4\uC57C
    \uD569\uB2C8\uB2E4."
  successTitle: "G0 \uB370\uBAA8 \uC644\uB8CC"
  successBody: "CCTV\uAC00 \uC9D6\uACE0, \uACBD\uBE44\uAC00 \uC18C\uB9AC\uC758 \uD488\uC885\uC744
    \uD655\uC778\uD558\uB7EC \uB5A0\uB0AC\uACE0, \uBCBD\uC740 \uD3ED\uBC1C\uC801\uC778
    \uC11C\uB958 \uC815\uB9AC\uB97C \uB2F9\uD588\uC2B5\uB2C8\uB2E4. \uC138 \uBC29
    \uBAA8\uB450 \uC774\uC81C \uD558\uB098\uC758 \uC9E7\uC740 \uB370\uBAA8\uB85C
    \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
  nextSceneName: StickerWorld3DPrototype
  nextStageLabel: "\uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC"
