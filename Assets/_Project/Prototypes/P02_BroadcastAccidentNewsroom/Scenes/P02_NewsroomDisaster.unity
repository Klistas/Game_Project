  prototypeId: P02
  prototypeTitle: "\uBC29\uC1A1\uC0AC\uACE0 \uB274\uC2A4\uB8F8"
  oneLineHook: "\uCE74\uBA54\uB77C, \uC790\uB9C9, \uBC30\uACBD \uC0AC\uAC74\uC744
    \uC870\uC791\uD574 \uC0DD\uBC29\uC1A1\uC744 \uC77C\uBD80\uB7EC \uB9DD\uCE5C\uB2E4."
  statusBadge: "\uC178\uB9CC \uAD6C\uD604"
  controlsText: "\uB9C8\uC6B0\uC2A4: \uC608\uC815\uB41C \uCE74\uBA54\uB77C \uD504\uB808\uC784
    \uB4DC\uB798\uADF8\n\uBC84\uD2BC: \uC608\uC815\uB41C \uC790\uB9C9\uACFC \uC0AC\uAC74
    \uC120\uD0DD\n\uD604\uC7AC: \uC774\uB3D9\uACFC \uACB0\uACFC \uBBF8\uB9AC\uBCF4\uAE30\uB9CC
    \uAC00\uB2A5"
  interactionPlaceholder: "\uB274\uC2A4\uB8F8 \uC870\uC791 \uC601\uC5ED \uC790\uB9AC\uC785\uB2C8\uB2E4.
    \uC774\uD6C4 \uC575\uCEE4, \uCE74\uBA54\uB77C \uD504\uB808\uC784, \uC790\uB9C9
    \uC120\uD0DD, \uC0AC\uAC74, \uBC29\uC1A1 \uD488\uC9C8, \uC0AC\uACE0 \uC9C0\uC218\uAC00
    \uB4E4\uC5B4\uAC11\uB2C8\uB2E4."
