  m_Script: {fileID: 11500000, guid: 3dbb9fde871a34843b0b59a498bf2bac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ViralPartyPrototypeLab.Prototype.PrototypeSceneTemplate
  prototypeId: P05
  prototypeTitle: "\uC678\uACC4\uC5B4 \uCF5C\uC13C\uD130"
  oneLineHook: "\uC678\uACC4 \uACE0\uAC1D\uC758 \uD45C\uC815\uACFC \uC544\uC774\uCF58\uB9CC
    \uBCF4\uACE0 \uBBFC\uC6D0\uC744 \uD574\uACB0\uD55C\uB2E4."
  statusBadge: "\uC178\uB9CC \uAD6C\uD604"
  controlsText: "\uB9C8\uC6B0\uC2A4: \uC608\uC815\uB41C \uB2E8\uC11C\uC640 \uD574\uACB0\uCC45
    \uD074\uB9AD\n\uD78C\uD2B8: \uC608\uC815\uB41C \uB3C4\uC6C0 \uBC84\uD2BC\n\uD604\uC7AC:
    \uC774\uB3D9\uACFC \uACB0\uACFC \uBBF8\uB9AC\uBCF4\uAE30\uB9CC \uAC00\uB2A5"
  interactionPlaceholder: "\uCF5C\uC13C\uD130 \uB370\uC2A4\uD06C \uC790\uB9AC\uC785\uB2C8\uB2E4.
    \uC774\uD6C4 \uC678\uACC4\uC778 \uCD08\uC0C1, \uAC10\uC815 \uC544\uC774\uCF58,
    \uBB38\uC81C \uB2E8\uC11C, \uD574\uACB0 \uBC84\uD2BC, \uB9CC\uC871\uB3C4\uAC00
    \uB4E4\uC5B4\uAC11\uB2C8\uB2E4."
  accentColor: {r: 0.42, g: 0.82, b: 0.55, a: 1}
  rebuildOnAwake: 0
